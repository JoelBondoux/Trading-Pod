# Public build-time values only. Never put credentials in VITE_ variables.
VITE_GOOGLE_CLIENT_ID=
# Local development uses Vite's /api proxy to the FC worker on port 8788.
# For a future deployment, use the exact HTTPS FC API URL or a same-origin proxy.
VITE_API_URL=/api
# Missing Google client ID keeps the dashboard locked.
# Allowed Google subject IDs are configured on the FC server.
