{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trading-pod-fc",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "d1_databases": [
    {
      "binding": "TRADE_DB",
      "database_name": "trading-pod-db",
      "database_id": "REPLACE_WITH_ACTUAL_DB_ID",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "REPLACE_WITH_ACTUAL_KV_ID",
    },
  ],
  "services": [
    {
      "binding": "TREASURER_SERVICE",
      "service": "trading-pod-treasurer",
    },
    {
      "binding": "EVENT_STREAM_SERVICE",
      "service": "trading-pod-event-stream",
    },
  ],
  // Secrets (set via `wrangler secret put`):
  //   INTERNAL_SERVICE_SECRET — shared auth token for service-to-service calls
  //   DASHBOARD_ALLOWED_SUBJECTS — comma-separated, verified Google subject IDs
  // No broker credentials are needed or consumed in this milestone.
  "vars": {
    "TRADING_MODE": "RESEARCH",
    "GOOGLE_CLIENT_ID": "",
    "DASHBOARD_ORIGIN": "http://localhost:3000",
  },
}
